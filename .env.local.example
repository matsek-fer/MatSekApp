# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle by Next.js. Treat
# them as public. Everything else is server-only and must stay out of the repo.

# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security — full read/write on every table.
# Server-side only (used by createAdminClient() to write notifications).
# Never prefix this with NEXT_PUBLIC_, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SMTP (university mail server) ──────────────────────────────────────────
SMTP_HOST=smtp.fer.hr
SMTP_PORT=587
SMTP_USER=mathclub@fer.hr
SMTP_PASS=your-smtp-password
SMTP_FROM="Math Club FER" <mathclub@fer.hr>

# ── AI assistant ───────────────────────────────────────────────────────────
# SECRET. Encrypts every member's provider API key (Anthropic / OpenAI /
# Google) before it is written to their cookie. Anything holding this value
# can decrypt those keys, and they bill to the member's personal account —
# treat it with the same care as the service role key above.
#
# Generate with:  openssl rand -base64 32
#
# Never prefix this with NEXT_PUBLIC_. That would compile it into the browser
# bundle and hand it to every visitor. Changing it invalidates every saved
# key; members simply enter theirs again.
AI_KEY_ENCRYPTION_SECRET=your-base64-32-byte-secret

# Not a secret. Where the local embedding model (~130 MB, downloaded once on
# first ingest) is cached. Defaults to .model-cache/ in the project root;
# point it at a persistent data directory in deployments.
#AI_EMBEDDINGS_CACHE_DIR=/var/lib/matsek/model-cache

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
