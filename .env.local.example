# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle by Next.js. Treat
# them as public. Everything else is server-only and must stay out of the repo.
#
# Signup and password-reset codes are mailed by the app itself now, so SMTP
# has to work for anyone to register.

# ── Postgres ───────────────────────────────────────────────────────────────
# SECRET (the password). Any PostgreSQL 15+ with db/schema.sql applied as the
# `matsek` role, which owns the schema and so bypasses Row Level Security —
# treat this URL like the service role key it replaces.
DATABASE_URL=postgres://matsek:your-app-db-password@localhost:5432/matsek
# Connections per server process; replicas × this must fit max_connections.
#DATABASE_POOL_MAX=10

# ── S3 (activity material files) ───────────────────────────────────────────
# Any S3-compatible store. The bucket is created on first upload if missing.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=activity-materials
# SECRET.
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
# Path-style is the default (right for SeaweedFS, MinIO, Garage, R2); set to
# false for AWS S3.
#S3_FORCE_PATH_STYLE=false

# ── SMTP (university mail server) ──────────────────────────────────────────
SMTP_HOST=smtp.fer.hr
SMTP_PORT=587
SMTP_USER=mathclub@fer.hr
# In deploy/.env a value containing `$` must be single-quoted ('ab$cd') or
# written as `$$`: docker compose expands `$cd` to an empty string otherwise,
# and the server would start with a truncated password.
SMTP_PASS=your-smtp-password
# Quote the whole value, not the display name alone: docker compose's parser
# rejects `"Name" <addr>` (text after a closing quote), while Next's accepts
# it, so the mistake only shows on the server.
SMTP_FROM="Math Club FER <mathclub@fer.hr>"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Not a secret, not required. Where the MatSek library site lives; the
# proposal form reads its search index from <url>/index/index.json. Only
# set it to point at a local or staging build of matsek-fer/library.
#LIBRARY_SITE_URL=https://matsek-fer.github.io/library/
