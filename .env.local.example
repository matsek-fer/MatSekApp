# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_* values are inlined into the browser bundle by Next.js. Treat
# them as public. Everything else is server-only and must stay out of the repo.

# ── Supabase ───────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET. Bypasses Row Level Security — full read/write on every table.
# Server-side only (used by createAdminClient() to write notifications).
# Never prefix this with NEXT_PUBLIC_, and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── SMTP (university mail server) ──────────────────────────────────────────
SMTP_HOST=smtp.fer.hr
SMTP_PORT=587
SMTP_USER=mathclub@fer.hr
# In deploy/.env a value containing `$` must be single-quoted ('ab$cd') or
# written as `$$`: docker compose expands `$cd` to an empty string otherwise,
# and the server would start with a truncated password.
SMTP_PASS=your-smtp-password
# Quote the whole value, not the display name alone: docker compose's parser
# rejects `"Name" <addr>` (text after a closing quote), while Next's accepts
# it, so the mistake only shows on the server.
SMTP_FROM="Math Club FER <mathclub@fer.hr>"

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
