# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can include secrets)
.env
.env*.local
.env.development
.env.production
# but allow example env files
!.env*.example
!.env*.sample

# typescript
*.tsbuildinfo
next-env.d.ts

# testing
/coverage

# copied from node_modules by scripts/copy-pdf-worker.mjs on dev and build
/public/pdf.worker.min.mjs

# copilot instructions
copilot-instructions

# agent-local state (worktrees carry their own .env.local — never commit)
/.claude/

# local embedding model cache (downloaded on first ingest; see lib/ai/embeddings.ts)
/.model-cache/
